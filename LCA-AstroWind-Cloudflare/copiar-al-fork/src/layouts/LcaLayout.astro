---
import { Font } from 'astro:assets';
import Metadata from '~/components/common/Metadata.astro';
import Header from '~/components/lca/Header.astro';
import Footer from '~/components/lca/Footer.astro';
import { siteIndexable } from '~/data/lca/site';
import type { MetaData } from '~/types';
import '~/assets/styles/lca.css';

export interface Props {
  metadata: MetaData;
}
const { metadata } = Astro.props;
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#001517" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-inter" preload />
    <Metadata {...metadata} robots={{ index: siteIndexable && metadata.robots?.index !== false, follow: true }} />
    <link rel="icon" type="image/svg+xml" href="/lca/favicon.svg" />
    <link rel="apple-touch-icon" href="/lca/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body id="inicio">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
  </body>
</html>
