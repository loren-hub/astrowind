---
import Layout from '~/layouts/LcaLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Hero from '~/components/lca/Hero.astro';
import Services from '~/components/lca/Services.astro';
import AISection from '~/components/lca/AISection.astro';
import Compliance from '~/components/lca/Compliance.astro';
import Process from '~/components/lca/Process.astro';
import Insights from '~/components/lca/Insights.astro';
import FAQ from '~/components/lca/FAQ.astro';
import Contact from '~/components/lca/Contact.astro';
import { SITE } from 'astrowind:config';
import { company } from '~/data/lca/site';
import { services } from '~/data/lca/services';

const metadata = {
  title: 'Consultoría IT, IA y ciberseguridad en España | LCA',
  ignoreTitleTemplate: true,
  description:
    'Consultoría informática y ciberseguridad para empresas en España. IA, automatización, MDR, Zero Trust, pentesting y adecuación a DORA, NIS2 y ENS.',
  openGraph: { type: 'website', locale: 'es_ES' },
};
if (!SITE.site) throw new Error('Configura site.site en src/config.yaml');
const base = new URL(SITE.site);
const orgId = new URL('/#organizacion', base).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: company.name,
      url: base.href,
      logo: new URL('/lca/logo.png', base).href,
      email: company.email,
      sameAs: [company.linkedin],
      areaServed: { '@type': 'Country', name: 'España' },
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#web', base).href,
      name: company.name,
      url: base.href,
      inLanguage: 'es-ES',
      publisher: { '@id': orgId },
    },
    ...services.map((service) => ({
      '@type': 'Service',
      '@id': new URL(`/#servicio-${service.id}`, base).href,
      name: service.title,
      description: service.description,
      serviceType: service.title,
      provider: { '@id': orgId },
      areaServed: { '@type': 'Country', name: 'España' },
      url: new URL(`/#servicio-${service.id}`, base).href,
    })),
  ],
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />
  <Hero /><Services /><AISection /><Compliance /><Process /><Insights /><FAQ /><Contact />
</Layout>
