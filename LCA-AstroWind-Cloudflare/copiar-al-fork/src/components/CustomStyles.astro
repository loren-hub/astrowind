---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(0 149 137);
    --aw-color-secondary: rgb(0 107 99);
    --aw-color-accent: rgb(0 107 99);

    --aw-color-text-heading: rgb(0 21 23);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(250 252 252);

    --aw-color-bg-page-dark: rgb(0 21 23);

    ::selection {
      background-color: #46d37d;
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(0 149 137);
    --aw-color-secondary: rgb(0 107 99);
    --aw-color-accent: rgb(0 107 99);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(0 21 23);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
