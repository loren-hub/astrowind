{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lca-technology-solutions",
  "main": "worker/contact.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CONTACT_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://lcatechnologysolutions.com,https://www.lcatechnologysolutions.com",
    "CONTACT_FROM": "web@forms.lcatechnologysolutions.com",
    "CONTACT_TO": "info@lcatechnologysolutions.com",
  },
  "send_email": [{ "name": "EMAIL", "destination_address": "info@lcatechnologysolutions.com" }],
  "ratelimits": [{ "name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": false },
}
