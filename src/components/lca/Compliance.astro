---
import { Icon } from 'astro-icon/components';
const frameworks = [
  {
    name: 'DORA',
    label: 'RESILIENCIA FINANCIERA',
    text: 'Riesgo TIC, terceros, continuidad e incidentes para entidades financieras y su cadena de suministro, según alcance.',
  },
  {
    name: 'NIS2',
    label: 'GESTIÓN DEL RIESGO',
    text: 'Evaluación de aplicabilidad, gobierno, medidas de seguridad y preparación de evidencias según el marco nacional vigente.',
  },
  {
    name: 'ENS',
    label: 'SECTOR PÚBLICO',
    text: 'Categorización, análisis de riesgos y adecuación de sistemas del sector público y de sus proveedores sujetos al esquema.',
  },
];
---

<section id="cumplimiento" class="section compliance-section" aria-labelledby="compliance-title">
  <div class="wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / CUMPLIMIENTO CON SENTIDO</p><h2 id="compliance-title">
          De la obligación<br />a la práctica.
        </h2>
      </div><div>
        <p>
          Primero identificamos qué te aplica. Después lo convertimos en un plan técnico y documental que puedas
          mantener.
        </p><a class="text-link" href="#contacto" data-service="cumplimiento"
          >Revisar mi situación <Icon name="tabler:arrow-up-right" /></a
        >
      </div>
    </div><div class="compliance-grid">
      {
        frameworks.map((item) => (
          <article>
            <>
              <p class="eyebrow">{item.label}</p>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </>
          </article>
        ))
      }
    </div><p class="compliance-note">
      <Icon name="tabler:info-circle" /> El acompañamiento prepara la adecuación. La certificación o auditoría independiente
      se realiza cuando corresponda.
    </p>
  </div>
</section>
